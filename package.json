{
  "name": "lattice",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:seed": "ts-node apps/web/scripts/seed.ts"
  },
  "devDependencies": {
    "turbo": "^1.13.4",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2"
  },
  "packageManager": "npm@10.8.1",
  "engines": {
    "node": ">=20.0.0"
  }
}
